# =============================================================================
# CONFIGURACIÓN DE ENTORNO PARA ARTECANÍAS CHIGORODÓ
# =============================================================================
# Copia este archivo a .env y completa los valores antes de ejecutar

# =============================================================================
# BASE DE DATOS MySQL
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=artesanias_chigorodo
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql

# =============================================================================
# BASE DE DATOS MongoDB (para auditoría)
# =============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=artesanias_chigorodo

# =============================================================================
# JWT - SEGURIDAD
# =============================================================================
# Genera un secret key seguro con: openssl rand -base64 64
SECURITY_JWT_SECRET_KEY=tu_secret_key_seguro_base64_minimo_64_caracteres
# Tiempo de expiración en milisegundos (24 horas = 86400000)
SECURITY_JWT_EXPIRATION_TIME=86400000

# =============================================================================
# CORREO ELECTRÓNICO (JavaMailSender)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion  # Usa contraseña de aplicación, NO tu contraseña normal

# =============================================================================
# CORS - Orígenes permitidos
# =============================================================================
# En producción: especifica los dominios exactos, separados por comas
# Ejemplo: https://tudominio.com,https://www.tudominio.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5501,http://localhost:5502

# =============================================================================
# URL BASE DE LA APLICACIÓN
# =============================================================================
APP_BASE_URL=http://localhost:8080

# =============================================================================
# DIRECTORIO DE SUBIDA DE IMÁGENES
# =============================================================================
APP_UPLOAD_DIR=uploads

# =============================================================================
# NOTAS DE SEGURIDAD IMPORTANTES:
# =============================================================================
# 1. NUNCA comitas el archivo .env al repositorio
# 2. El .env ya está en .gitignore
# 3. Para Gmail: activa "Contraseña de aplicación" en tu cuenta
# 4. Usa conexiones SSL para la base de datos en producción
# 5. Genera un JWT secret key fuerte y único para cada entorno
# 6. En producción, configura CORS con dominios específicos, no wildcards
